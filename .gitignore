# Environments and caches
.venv/
.pytest_cache/
__pycache__/
*.pyc

# Experiment outputs: keep result summaries, the report and the probe scripts;
# not checkpoints, feature dumps, trained decoders, logs or videos (they are large and regenerable).
outputs/**
!outputs/**/
!outputs/**/*.json
!outputs/**/*.md
!outputs/probe/*.py
!outputs/probe/*.sh
!outputs/probe/*.jsonl

# Run state, not results (the aggregates above hold every finished job): resume caches, smoke tests, heartbeats, checkpoints
outputs/**/jobs/
outputs/**/smoke/
outputs/**/heartbeat/
outputs/**/ckpt/

# Third-party weights: Menlo's teacher policy exported to numpy (rebuilt by wsp/controller/export_teacher.py), not ours to publish
wsp/controller/teacher_weights.npz
