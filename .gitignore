# Environments and caches
.venv/
.pytest_cache/
__pycache__/
*.pyc

# Experiment outputs: keep result summaries, the report and the probe scripts;
# not checkpoints, feature dumps, trained decoders, logs or videos (they are large and regenerable).
outputs/**
!outputs/**/
!outputs/**/*.json
!outputs/**/*.md
!outputs/probe/*.py
!outputs/probe/*.sh
!outputs/probe/*.jsonl

# Run state, not results (the aggregates above hold every finished job): resume caches, smoke tests, heartbeats, checkpoints
outputs/**/jobs/
outputs/**/smoke/
outputs/**/heartbeat/
outputs/**/ckpt/
outputs/**/*smoke*.json

# Per-burst detail behind a summary JSON (MBs, regenerable from the recordings)
outputs/**/*.bursts.json

# Third-party weights: Menlo's teacher policy exported to numpy (rebuilt by wsp/controller/export_teacher.py), not ours to publish
wsp/controller/teacher_weights.npz

# Public data from other labs (track B, B0): third-party files, never committed
outputs/public_data/raw/
# FinalSpark datasets fs369 (65 GB) and fs437 (1.8 GB), zips and their extracts (covered by the line above; named so a move can't expose them)
outputs/public_data/raw/finalspark/
fs369*/
fs437*/
fs369*.zip
fs437*.zip
